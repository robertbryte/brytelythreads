{
  "name": "brytely-threads",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply brytely-threads --local",
    "db:migrate": "wrangler d1 migrations apply brytely-threads --remote",
    "printify:shops": "node --env-file=.dev.vars scripts/printify-shops.mjs",
    "stripe:listen": "stripe listen --forward-to localhost:8787/api/webhooks/stripe",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.8.0",
    "next": "15.5.26",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.38.0"
  },
  "engines": { "node": ">=22.5" }
}
