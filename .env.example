# ─────────────────────────────────────────────────────────────────────────────
# Brytely Threads — required configuration
#
# LOCAL DEV:   copy this file to `.dev.vars` (git-ignored) and fill it in.
# PRODUCTION:  set each SECRET with `npx wrangler secret put NAME`
#              and the plain settings in wrangler.jsonc → "vars".
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets ──────────────────────────────────────────────────────────────────
# Printify → Account → Connections → Personal access tokens.
# Scopes needed: shops.read, products.read, products.write, orders.read,
# orders.write, webhooks.read, webhooks.write
PRINTIFY_API_TOKEN=
# From `npm run printify:shops` (lists your shops and their ids)
PRINTIFY_SHOP_ID=
# Any long random string (e.g. `openssl rand -hex 32`). Used to sign/verify Printify webhooks.
PRINTIFY_WEBHOOK_SECRET=

# Stripe → Developers → API keys. Use sk_test_… until you go live.
STRIPE_SECRET_KEY=sk_test_
# Stripe → Developers → Webhooks → your endpoint → Signing secret (whsec_…)
# For local testing, `stripe listen` prints one.
STRIPE_WEBHOOK_SECRET=whsec_

# Admin login for /admin (password must be at least 12 characters)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: Resend API key for order confirmation / shipped / alert emails
RESEND_API_KEY=

# ── Plain settings (production values live in wrangler.jsonc "vars") ────────
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
EMAIL_FROM=Brytely Threads <orders@yourdomain.com>
ADMIN_ALERT_EMAIL=you@example.com
# "false" = orders are created in Printify but wait for you to approve (use for testing)
# "true"  = orders go straight to production after payment (use when live)
PRINTIFY_SEND_TO_PRODUCTION=false
# 1 standard · 2 priority · 3 express · 4 economy
PRINTIFY_SHIPPING_METHOD=1
# all_visible = every visible Printify product appears; published_only = only products you "Publish" in Printify
CATALOG_MODE=all_visible
SHIPPING_COUNTRIES=US
SHIPPING_RATES=[{"label":"Standard","amount":499,"additional":200,"minDays":5,"maxDays":10,"freeOver":7500}]
STRIPE_AUTOMATIC_TAX=false
MIRROR_IMAGES=false
MAX_IMAGES_PER_PRODUCT=10
NEXT_PUBLIC_CF_IMAGE_RESIZING=false
